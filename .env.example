# Spajanje: 127.0.0.1:3306 | baza: eventhub

# root — administrator, pristup objema bazama
MARIADB_ROOT_PASSWORD=

# eventhub_app — poslovne procedure i izvjestajni viewovi baze eventhub
EVENTHUB_APP_PASSWORD=

# eventhub_report — samo citanje svih tablica i viewova baze eventhub
EVENTHUB_REPORT_PASSWORD=

# Performance baza: eventhub_perf.
# Isti host i port; koristi root i MARIADB_ROOT_PASSWORD.